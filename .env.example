# Existing .env is never overwritten. Choose one provider explicitly.
LLM_PROVIDER=gms
GMS_KEY=
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1/
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/
CHAT_MODEL=gpt-5.4-nano
EMBEDDING_MODEL=text-embedding-3-small
POKEMON_DATA_DIR=pokemon-data/data/processed
CHROMA_DIR=chroma_db
TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
# Required for new Wikipedia requests; use your real operator email/contact URL/wiki user.
# Leave blank until the operator supplies it. Cached documents remain available.
WIKI_CONTACT=
WIKI_INTERVAL=6.2
AUTO_COLLECT_DOCUMENTS=false
HIGH_ATTACK=100
HIGH_DEFENSE=100
HIGH_SPECIAL_ATTACK=100
HIGH_SPECIAL_DEFENSE=100
HIGH_SPEED=100
CANDIDATE_LIMIT=25
RESULT_LIMIT=6
